---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Corey Karnei',
  description = 'Corey Karnei — ML engineer. Site under construction.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%230a0f1f'/%3E%3Ccircle cx='16' cy='16' r='6' fill='%23ff8a00'/%3E%3C/svg%3E"
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
