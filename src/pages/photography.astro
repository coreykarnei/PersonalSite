---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { photoGroups } from '../data/photography';

const allPhotos = photoGroups.flatMap((group) =>
  group.photos.map((photo) => ({ ...photo, region: group.region })),
);
const slideCount = allPhotos.length;
---

<Layout
  title="Photography — Corey Karnei"
  description="Photographs by Corey Karnei. Mostly landscapes."
>
  <main class="page" data-slide-count={slideCount}>
    <header class="overlay-top">
      <a class="back" href="/" aria-label="Back to home">
        <svg
          viewBox="0 0 24 24"
          width="14"
          height="14"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M19 12H5"></path>
          <path d="M11 18l-6-6 6-6"></path>
        </svg>
        <span>Home</span>
      </a>
      <span class="meta">
        <span class="meta-region" id="meta-region">{allPhotos[0]?.region ?? ''}</span>
        <span class="meta-sep" aria-hidden="true">·</span>
        <span class="meta-counter">
          <span id="meta-current">1</span>
          <span class="meta-of">/ {slideCount}</span>
        </span>
      </span>
    </header>

    <div class="frame" aria-hidden="false">
      {
        allPhotos.map((photo, i) => (
          <div
            class="slide"
            data-index={i}
            data-region={photo.region}
            style={i === 0 ? 'opacity: 1' : undefined}
          >
            <Image
              src={photo.src}
              alt={photo.caption ?? photo.location ?? photo.region}
              widths={[1200, 1800, 2400]}
              sizes="100vw"
              format="webp"
              quality={82}
              loading={i < 3 ? 'eager' : 'lazy'}
              decoding="async"
            />
            {(photo.location || photo.year) && (
              <figcaption>
                {photo.location && <span>{photo.location}</span>}
                {photo.location && photo.year && (
                  <span class="cap-sep" aria-hidden="true">·</span>
                )}
                {photo.year && <span>{photo.year}</span>}
              </figcaption>
            )}
          </div>
        ))
      }
    </div>

    <div class="scroll-track" aria-hidden="true">
      {
        Array.from({ length: slideCount }, (_, i) => (
          <div class="snap-stop" data-snap-index={i} />
        ))
      }
    </div>

    <div class="end-hint" aria-hidden="true">
      <a href="/">← back to home</a>
    </div>
  </main>
</Layout>

<script>
  const main = document.querySelector('main');
  const slides = Array.from(
    document.querySelectorAll<HTMLElement>('.slide'),
  );
  const metaRegion = document.getElementById('meta-region');
  const metaCurrent = document.getElementById('meta-current');

  if (main && slides.length > 0 && metaRegion && metaCurrent) {
    const slideCount = slides.length;
    let lastActive = -1;
    let raf = 0;

    const update = () => {
      const maxScroll = Math.max(
        document.documentElement.scrollHeight - window.innerHeight,
        1,
      );
      const rawProgress = window.scrollY / maxScroll;
      const progress =
        Math.max(0, Math.min(1, rawProgress)) * (slideCount - 1);

      const floor = Math.floor(progress);
      const frac = progress - floor;

      for (let i = 0; i < slideCount; i++) {
        const slide = slides[i];

        let opacity = 0;
        let drift = 0;
        let zoom = 1;
        let zIndex = 0;

        if (i === floor) {
          // outgoing / back layer — stays fully opaque so the incoming alpha
          // composites cleanly on top
          opacity = 1;
          drift = -frac * 14;
          zoom = 1 + frac * 0.025;
          zIndex = 1;
        } else if (i === floor + 1 && frac > 0) {
          // incoming / top layer — fades in
          opacity = frac;
          drift = (1 - frac) * 14;
          zoom = 1 + (1 - frac) * 0.025;
          zIndex = 2;
        }

        slide.style.opacity = opacity.toString();
        slide.style.transform = `translate3d(0, ${drift}px, 0) scale(${zoom})`;
        slide.style.zIndex = zIndex.toString();
      }

      const active = Math.min(slideCount - 1, Math.max(0, Math.round(progress)));
      if (active !== lastActive) {
        lastActive = active;
        const slide = slides[active];
        const region = slide.dataset.region ?? '';
        metaRegion.textContent = region;
        metaCurrent.textContent = String(active + 1);
      }
    };

    const onScroll = () => {
      if (!raf) {
        raf = requestAnimationFrame(() => {
          update();
          raf = 0;
        });
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }
</script>

<style is:global>
  html {
    scroll-behavior: smooth;
    scroll-snap-type: y mandatory;
  }
</style>

<style>
  .page {
    position: relative;
    background: var(--bg-deep);
    color: var(--text);
    min-height: 100vh;
  }

  /* Top overlay: thin, semi-transparent, always visible */
  .overlay-top {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.1rem clamp(1rem, 4vw, 2rem);
    background: linear-gradient(
      180deg,
      rgba(6, 9, 18, 0.85) 0%,
      rgba(6, 9, 18, 0) 100%
    );
    pointer-events: none;
  }
  .overlay-top > * {
    pointer-events: auto;
  }

  .back {
    color: var(--muted);
    font-family: var(--font-display);
    font-size: 0.85rem;
    letter-spacing: -0.01em;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    transition: color 140ms ease;
  }
  .back:hover {
    color: var(--orange-warm);
  }

  .meta {
    color: var(--muted);
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
  }
  .meta-region {
    color: var(--orange-warm);
  }
  .meta-sep {
    opacity: 0.4;
  }
  .meta-of {
    opacity: 0.55;
    margin-left: 0.15rem;
  }

  /* Fixed frame holding stacked photos. Native scroll moves through scroll-track,
     JS reads scroll position and crossfades slides via opacity + subtle drift/zoom. */
  .frame {
    position: fixed;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 1;
  }

  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    will-change: opacity, transform;
  }

  .slide :global(img) {
    display: block;
    max-width: 94vw;
    max-height: 88vh;
    width: auto;
    height: auto;
    object-fit: contain;
    background: var(--bg);
  }

  figcaption {
    position: absolute;
    bottom: clamp(1.5rem, 4vh, 3rem);
    left: 0;
    right: 0;
    text-align: center;
    color: var(--muted);
    font-family: var(--font-display);
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    pointer-events: none;
  }

  figcaption .cap-sep {
    opacity: 0.45;
  }

  /* Scroll-track: one 100vh snap stop per photo. Native scroll-snap settles
     to the nearest stop when the user stops scrolling, so they always land
     on a fully-opaque photo. The fixed frame above reads scrollY each frame
     to drive the crossfade. */
  .scroll-track {
    width: 100%;
    pointer-events: none;
    position: relative;
  }
  .snap-stop {
    height: 100vh;
    scroll-snap-align: start;
  }

  /* Tiny exit hint at the very bottom of the scroll. */
  .end-hint {
    position: relative;
    z-index: 2;
    padding: 6vh 0 8vh;
    text-align: center;
    font-family: var(--font-display);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .meta-region {
      max-width: 36vw;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    figcaption {
      font-size: 0.72rem;
      letter-spacing: 0.1em;
    }
  }
</style>
